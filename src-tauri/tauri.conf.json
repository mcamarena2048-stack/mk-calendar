{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MK Calendar",
  "version": "8.0.0",
  "identifier": "com.mk.calendar-v80",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MK Calendar",
        "x":5,
        "y":5,
        "width": 420,
        "height": 620,
	"transparent": true,
	"decorations": true,
	"alwaysOnTop": false,
	"alwaysOnBottom": false,
	"skipTaskbar": false,
	"resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
